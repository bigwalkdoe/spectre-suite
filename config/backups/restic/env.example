# spectre-suite restic backup configuration (adopted spectre-backup engine)
# Copy to ~/.secrets/spectre-suite-backups.env (chmod 600). Never commit real credentials.
# The repository key lives in RESTIC_PASSWORD_FILE, not in this file.

# --- Repositories (preserve existing repo/password; no re-key) ---
RESTIC_REPOSITORY="rclone:spectre-backup:"
RESTIC_REPOSITORY_LOCAL="/backups/spectre-backup"
RESTIC_PASSWORD_FILE="$HOME/.secrets/spectre-restic-password"

# --- Logging/state ---
LOG_DIR="$HOME/.local/state/spectre-suite/backups"

# --- Host PostgreSQL cluster (socket) and Podman/Docker config capture ---
PG_ENABLED="true"
PG_HOST="/var/run/postgresql"
PG_PORT="5432"
PG_USER="deon"
CONTAINERS_ENABLED="true"

# --- Notifications (desktop only makes sense on workstations) ---
NOTIFY_ENABLED="true"
NOTIFY_DESKTOP="true"

# --- Google Drive/rclone pacing (preserve deployed values) ---
RCLONE_TPSLIMIT=20
RCLONE_TPSLIMIT_BURST=40
RCLONE_DRIVE_CHUNK_SIZE=64M
RCLONE_RETRIES=10
RCLONE_LOW_LEVEL_RETRIES=15

# --- Tags/retention identity ---
RESTIC_TAG="spectre-suite"
RESTIC_HOST="$(hostname -s)"

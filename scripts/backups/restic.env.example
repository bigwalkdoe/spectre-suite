# Copy to a secure location outside the repo (e.g. ~//.secrets/restic.env)
# and set RESTIC_CONFIG=/path/to/restic.env. Never commit real values.
#
# Versatile backends (set RESTIC_REPOSITORY accordingly):
#   Local:       /backups/spectre-backup
#   SFTP:        sftp:user@host:/path/to/repo
#   REST server: rest:https://user@host/
#   S3:          s3:https://s3.amazonaws.com/bucket/prefix  (+ AWS_* creds)
#   B2:          b2:bucket:/prefix                          (+ B2_ACCOUNT_ID/B2_ACCOUNT_KEY)
#   rclone:      rclone:remote:path
#
# This dev machine: local-only default
RESTIC_REPOSITORY=/backups/spectre-backup
RESTIC_PASSWORD_FILE=~//.secrets/restic-repo-password
# RESTIC_PASSWORD=           # avoid; prefer RESTIC_PASSWORD_FILE
# RESTIC_PASSWORD_COMMAND=   # alternative
# BACKUP_ROOT=/backups
# PROJECT_PREFIX=spectre-suite
# RESTIC_TAG=spectre-suite
# RESTIC_INCLUDE_CONFIGS=0

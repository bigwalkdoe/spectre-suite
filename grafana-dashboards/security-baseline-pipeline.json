  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "mode": "markdown",
        "content": "**Security baseline pipeline evidence** (`spectre_security_baseline_*`) \u2014 distinct from **Spectre agent runtime** (`spectre_agent_*` / `security_*` findings). States: `1` ok/clean/no-drift, `0` fail/findings/drift, `-1` unknown/skipped/not configured. **Never-run, unknown, and stale evidence must not be read as clean.** Source: suite baseline runner and/or spectre-security evidence (A/D hybrid)."
      }
    },
    {
      "type": "stat",
      "title": "Exporter up",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(spectre_security_baseline_exporter_up)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN/none",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {

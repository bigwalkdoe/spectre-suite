# Environment variables for Linux System Maintenance Suite
# Copy this file to .env and fill in your values

# Monitoring Stack
# All four below are REQUIRED: docker compose refuses to start without them
# rather than falling back to a default password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=generate-a-secure-password
GRAFANA_ROOT_URL=http://localhost:3002
REDIS_PASSWORD=generate-a-secure-password

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate-a-secure-password
POSTGRES_DB=postgres

# The DSN embeds POSTGRES_USER and POSTGRES_PASSWORD, so it must be kept in sync
# with them. Percent-encode the user, password and database when substituting
# them: a password containing '/' ends the URL authority and '+' is decoded as
# a space, either of which makes the exporter connect to the wrong host or fail
# to authenticate. To produce a correctly encoded value without doing it by
# hand:
#
#   python3 -c "import os,urllib.parse as u; \
#     print('postgresql://%s:%s@postgres:5432/%s?sslmode=disable' % (
#       u.quote(os.environ['POSTGRES_USER'],safe=''), \
#       u.quote(os.environ['POSTGRES_PASSWORD'],safe=''), \
#       u.quote(os.environ['POSTGRES_DB'],safe='')))"
#
# Host `postgres` is the Compose service name, not the container_name.
POSTGRES_EXPORTER_DSN=postgresql://postgres:generate-a-secure-password@postgres:5432/postgres?sslmode=disable

# Alertmanager Notifications
# These are NOT read by alertmanager.yml: Alertmanager performs no ${VAR}
# substitution in its config. scripts/setup-notification-channels.sh writes them
# to prometheus/alertmanager-secrets/, which is bind-mounted and gitignored.
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
PAGERDUTY_ROUTING_KEY=your-pagerduty-routing-key

# Backup Encryption
ENCRYPTION_KEY_FILE=/etc/spectre-system-maintenance/backup-key
ENCRYPTION_ALGORITHM=aes-256-cbc

# Remote Backup (rsync/S3/B2)
REMOTE_BACKUP_SERVER=backup.example.com
REMOTE_BACKUP_PORT=2222
REMOTE_BACKUP_USER=backup

[Unit]
Description=Spectre Suite tag-scoped restic prune
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/spectre-suite
Environment=RESTIC_CONFIG=%h/.secrets/spectre-suite-backups.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/bin/spectre run backups/restic/prune
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

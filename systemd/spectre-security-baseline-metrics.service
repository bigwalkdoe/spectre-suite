[Unit]
Description=Spectre Security Baseline Metrics Exporter (textfile, dispatched)
After=network.target

[Service]
Type=oneshot
# Adjust WorkingDirectory and python path for your checkout/install.
# SPECTRE_REPO_ROOT is optional: the exporter resolves the repo from its own
# location when it is unset, so this unit works from any checkout.
WorkingDirectory=/path/to/your/spectre-suite-checkout
Environment=SPECTRE_REPO_ROOT=/path/to/your/spectre-suite-checkout
ExecStart=/usr/bin/python3 -m spectre.cli.main run prometheus/security-baseline-metrics-exporter

[Install]
WantedBy=default.target

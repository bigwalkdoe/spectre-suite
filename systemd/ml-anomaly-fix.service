[Unit]
Description=ML Anomaly Detection + Free-LLM Remediation Pipeline
After=network.target docker.service ml-anomaly-detection.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/spectre-suite/spectre/actions/ml-anomaly
Environment=PATH=/opt/spectre-suite/spectre/actions/ml-anomaly/venv/bin
ExecStart=/opt/spectre-suite/spectre/actions/ml-anomaly/run_ml_pipeline.sh
